# Copy this file to .env and fill in real values for local development.
# Never commit the real .env file.

SECRET_KEY=change-me-to-a-random-string
JWT_SECRET_KEY=change-me-to-a-different-random-string

# From Google Cloud Console -> APIs & Services -> Credentials ->
# Create Credentials -> OAuth client ID -> Web application.
# Add your frontend origin(s) (e.g. http://localhost:8000 and your
# production domain) under "Authorized JavaScript origins".
GOOGLE_CLIENT_ID=

DATABASE_URL=sqlite:///app.db

# Comma-separated list of frontend origins allowed to call the API.
CORS_ORIGINS=http://localhost:8000,http://127.0.0.1:8000
