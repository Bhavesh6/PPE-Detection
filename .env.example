# Copy this file to .env and fill in real values for local development.
# Never commit the real .env file.

SECRET_KEY=change-me-to-a-random-string
JWT_SECRET_KEY=change-me-to-a-different-random-string

# From Google Cloud Console -> APIs & Services -> Credentials ->
# Create Credentials -> OAuth client ID -> Web application.
# Add your frontend origin(s) (e.g. http://localhost:8000 and your
# production domain) under "Authorized JavaScript origins".
GOOGLE_CLIENT_ID=

DATABASE_URL=sqlite:///app.db

# Comma-separated list of frontend origins allowed to call the API.
# Every origin the console is served from needs listing here, including
# tunnel hostnames. Quick-tunnel URLs are regenerated on each restart, so
# a stale entry left behind is normal — the current one must be present.
CORS_ORIGINS=http://localhost:8000,http://127.0.0.1:8000

# Site CCTV camera (esp32-main/cctv_cam). Base URL only, no trailing path
# — e.g. http://safetyfirst-cam.local or http://192.168.1.50
# Blank means no camera, and the Site Camera page says so plainly instead
# of showing a broken image.
#
# The backend connects *to* this address, so the machine running the API
# must be on the same network as the camera. A tunnel cannot substitute:
# it exposes the backend outward, which is the opposite direction.
CCTV_URL=

# Spoken gate announcements ("Access granted.", "Put on your hardhat...").
# From elevenlabs.io -> Profile -> API keys. Leave blank to keep using the
# browser's own (robotic) speechSynthesis — nothing else changes if you do.
ELEVENLABS_API_KEY=
# A voice_id from elevenlabs.io/app/voices — NOT /app/voice-library. On a
# free plan, the API rejects any voice that only lives in the library
# ("Free users cannot use library voices via the API") even if you've
# viewed or favorited it there. Open the voice in the library, click "Add
# to my voices" so it actually appears on the /voices page, then use its
# ID here. The default below (Rachel) needs that same one-time step.
ELEVENLABS_VOICE_ID=21m00Tcm4TlvDq8ikWAM

# In-app help chatbot. From aistudio.google.com -> Get API key — free
# tier, no card required. Leave blank to keep the chat widget showing
# "not configured" instead of erroring; nothing else on the site depends
# on this.
GEMINI_API_KEY=
# An alias, not a pinned version — pinning to a dated model name is what
# broke this once already (Google retired gemini-2.0-flash server-side).
# The *lite* alias specifically: the free tier's daily request cap is
# per-model, and the flagship alias only allows 20 requests/day, which one
# afternoon of testing exhausts. Set this to gemini-flash-latest if you
# have a paid key and want the stronger model.
GEMINI_MODEL=gemini-flash-lite-latest

# Fallback for the chatbot, used only when Gemini's daily quota runs out.
# Free key from console.groq.com, no card required. Blank is fine — the
# assistant just has one provider then, and says so when that runs dry.
GROQ_API_KEY=
GROQ_MODEL=llama-3.3-70b-versatile
