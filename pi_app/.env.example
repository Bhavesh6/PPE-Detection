# Copy to .env beside checkpoint.py and edit. Never commit the real .env.

# Where the SafetyFirst API lives. Must be reachable from the Pi — use the
# machine's LAN IP or a public URL, not localhost, unless the backend runs
# on the Pi itself.
SAFETYFIRST_API=http://192.168.1.9:5000

# Device account. Create it once via the web sign-up, then set it here so
# every entry decision is filed against this gate rather than a throwaway
# guest account. Leave both blank to fall back to a guest session.
SAFETYFIRST_EMAIL=
SAFETYFIRST_PASSWORD=

# Camera index. 0 is the first camera; try 1 if a second device is attached.
SAFETYFIRST_CAMERA=0

# Seconds between inference requests. Lower is more responsive but heavier
# on the API; 0.5 matches the web client.
SAFETYFIRST_INTERVAL=0.5

# Set to 1 to run in a normal window instead of fullscreen (useful while
# developing on a laptop).
SAFETYFIRST_WINDOWED=

# GPS module (optional). off (default) reports nothing and the console
# keeps showing whatever an admin set by hand.
#
#   auto     find a Quectel modem (the TracX-1b) by name under
#            /dev/serial/by-id, then fall back to SAFETYFIRST_GPS_PORT
#            only if you set it below. Falls back quietly to no GPS.
#   quectel  force the TracX-1b and fail loudly if it isn't found.
#   serial   force a plain NMEA module (e.g. NEO-6M) on the port below.
#
# The TracX-1b needs pyserial only. A NEO-6M needs pyserial and pynmea2
# (neither installed by default — see requirements.txt).
SAFETYFIRST_GPS=off

# Leave BLANK unless you are using a plain NMEA module. It is not needed
# for the TracX-1b, which is located by name. Do NOT set it to
# /dev/ttyUSB0 here: on this Pi that is the gate master ESP32, and the
# badge reader is already holding it.
SAFETYFIRST_GPS_PORT=
SAFETYFIRST_GPS_INTERVAL=20

# Site CCTV cameras (esp32-main/cctv_cam) on this Pi's local network.
# Comma-separated, id=url. The id labels the tile in the console and is
# the key frames are filed under, so it must be unique per camera:
#
#   SAFETYFIRST_CCTV_URL=gate=http://safetyfirst-gate.local,yard=http://192.168.1.51
#
# A bare URL works too (the id is derived from the hostname). Blank
# disables the relay entirely.
#
# NAME THEM EXPLICITLY if a camera also posts for itself (BACKEND_URL and
# UPLOAD_TOKEN set in its secrets.h). The camera files frames under its
# own CAM_ID, while a bare URL here derives an id from the hostname - so
# "http://safetyfirst-cam.local" becomes "safetyfirst-cam" and the same
# physical camera arrives as two tiles that never overwrite each other,
# which is exactly what the fallback is supposed to avoid. The camera
# prints the line to use at boot:
#
#   [ready] relay this as: cam=http://safetyfirst-cam.local
#
# The cameras have a local link to this Pi and no route of their own to
# the backend - a node down a shaft or inside a tunnel reaches the
# gateway beside it and nothing further. So the Pi fetches their frames
# and forwards them, using the API session it already signed in with.
# Each camera gets its own thread, so a dead one cannot throttle a
# healthy one behind it.
#
# Leave the backend's own CCTV_URL blank in this deployment, or it will
# try to fetch a camera directly and time out.
SAFETYFIRST_CCTV_URL=

# Seconds between frames posted to the backend. This is a send rate, not
# a fetch rate: the relay holds the camera's /stream open and always has
# the newest frame waiting, so this only decides how often one is
# forwarded.
#
# That distinction matters, because it used to be the other way round.
# When each frame cost a fetch and then a post in series, asking for them
# faster made things worse - measured at 0.2s the feed managed 0.35/sec,
# slower than it did at 1s. With the reader decoupled, the same link went
# to 3.80/sec at 0.1s.
#
# So the ceiling now is the uplink, not this number. Lower it until the
# rate stops improving; on a gateway using a phone hotspot through a
# tunnel that was around 0.1.
SAFETYFIRST_CCTV_INTERVAL=0.1

# Keep camera frames on disk while the backend is unreachable. Blank means
# an outage leaves no visual record at all.
#
# Not a replay queue: the backend holds one current frame per camera and
# has no concept of a frame from an hour ago, so posting a backlog would
# overwrite the live view with history and then discard it. What an outage
# needs is a local record of what the camera saw.
#
# Stored slower than the relay sends, and capped in total size with the
# oldest discarded first — a gate that fills its own SD card stops being
# a gate.
SAFETYFIRST_CCTV_STORE=
SAFETYFIRST_CCTV_STORE_MB=200
SAFETYFIRST_CCTV_STORE_INTERVAL=10

# Per-camera override, by id. Cameras are not equally fast: an OV2640
# encodes JPEG in hardware, while a GC2145 (RHYX-M21-45) has no encoder
# and compresses every frame on the CPU, which can take longer than the
# interval it was asked for. Polling it at the fast camera's rate just
# queues requests it cannot answer, and one global rate lets the slowest
# camera set the experience for all of them.
#
#   SAFETYFIRST_CCTV_INTERVAL_YARD=3.0
#
# The suffix is the camera id, uppercased.

# On-device inference. Point this at a YOLOv8 .onnx and the gate decides
# PPE compliance here instead of sending frames to the backend — so it
# keeps ruling with the network completely down, which the backend path
# cannot. Blank (the default) sends frames to the API as before.
#
#   SAFETYFIRST_ONNX_MODEL=/home/nexus/best.onnx
#
# Measured on a Pi 5: ~320ms per frame at 640x640, about 3.2 FPS across
# four cores. That is slow for video and fine here — the gate infers per
# badge scan, not continuously, and SAFETYFIRST_INTERVAL already throttles
# to one frame every 0.5s.
#
# The verdict rule is the same one the backend applies, deliberately: a
# worker should get the same answer whichever path ruled on them.
#
# Needs onnxruntime (already installed). Nothing else — no accelerator, no
# HailoRT, no version matching.
SAFETYFIRST_ONNX_MODEL=

# Optional overrides. Labels is one class name per line, in model order —
# leave blank to use the built-in list, which matches the trained model.
SAFETYFIRST_ONNX_LABELS=
SAFETYFIRST_ONNX_CONF=0.25
SAFETYFIRST_ONNX_IOU=0.45
# All four cores by default. Lower it if inference starves the camera or
# the badge reader on a busier box.
SAFETYFIRST_ONNX_THREADS=4

# How often (seconds) to retry attendance records that couldn't reach the
# backend and are waiting in the local queue (offline_queue.db).
SAFETYFIRST_QUEUE_FLUSH_INTERVAL=15

# How often buffered sensor readings are pushed to the cloud once it is
# reachable. Slower than the alert replay on purpose: an unseen hazard is
# time-critical, a temperature history is not.
SAFETYFIRST_READING_REPLAY_INTERVAL=30

# Shared secret the ESP32 sends as X-Device-Token when reporting a hazard
# straight to the Pi (used when the cloud is unreachable). Leave BLANK to
# keep that receiver switched off: it can hold the gate shut, so running it
# without a token would let anyone on the network stop the site. Set the
# same value in the sketch's secrets.h.
SAFETYFIRST_LOCAL_ALERT_TOKEN=
SAFETYFIRST_LOCAL_ALERT_PORT=8081

# Seconds between retrying locally-raised alerts against the cloud, and
# between roster/policy refreshes while it is reachable.
SAFETYFIRST_ALERT_REPLAY_INTERVAL=10
SAFETYFIRST_ROSTER_SYNC_INTERVAL=60
SAFETYFIRST_SIGNIN_RETRY_INTERVAL=20
