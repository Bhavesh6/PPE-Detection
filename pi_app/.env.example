# Copy to .env beside checkpoint.py and edit. Never commit the real .env.

# Where the SafetyFirst API lives. Must be reachable from the Pi — use the
# machine's LAN IP or a public URL, not localhost, unless the backend runs
# on the Pi itself.
SAFETYFIRST_API=http://192.168.1.9:5000

# Device account. Create it once via the web sign-up, then set it here so
# every entry decision is filed against this gate rather than a throwaway
# guest account. Leave both blank to fall back to a guest session.
SAFETYFIRST_EMAIL=
SAFETYFIRST_PASSWORD=

# Camera index. 0 is the first camera; try 1 if a second device is attached.
SAFETYFIRST_CAMERA=0

# Seconds between inference requests. Lower is more responsive but heavier
# on the API; 0.5 matches the web client.
SAFETYFIRST_INTERVAL=0.5

# Set to 1 to run in a normal window instead of fullscreen (useful while
# developing on a laptop).
SAFETYFIRST_WINDOWED=

# GPS module (optional). off (default) reports nothing and the console
# keeps showing whatever an admin set by hand.
#
#   auto     find a Quectel modem (the TracX-1b) by name under
#            /dev/serial/by-id, then fall back to SAFETYFIRST_GPS_PORT
#            only if you set it below. Falls back quietly to no GPS.
#   quectel  force the TracX-1b and fail loudly if it isn't found.
#   serial   force a plain NMEA module (e.g. NEO-6M) on the port below.
#
# The TracX-1b needs pyserial only. A NEO-6M needs pyserial and pynmea2
# (neither installed by default — see requirements.txt).
SAFETYFIRST_GPS=off

# Leave BLANK unless you are using a plain NMEA module. It is not needed
# for the TracX-1b, which is located by name. Do NOT set it to
# /dev/ttyUSB0 here: on this Pi that is the gate master ESP32, and the
# badge reader is already holding it.
SAFETYFIRST_GPS_PORT=
SAFETYFIRST_GPS_INTERVAL=20

# Site CCTV camera (esp32-main/cctv_cam) on this Pi's local network, e.g.
# http://safetyfirst-cam.local or http://192.168.1.50 — base URL, no path.
# Blank disables the relay.
#
# The camera has a local link to this Pi and no route of its own to the
# backend — a node down a shaft or inside a tunnel reaches the gateway
# beside it and nothing further. So the Pi fetches its frames and forwards
# them, using the API session it has already signed in with. The backend's
# own CCTV_URL should be left blank in that deployment, or it will try to
# fetch the camera directly and time out.
SAFETYFIRST_CCTV_URL=
SAFETYFIRST_CCTV_INTERVAL=1.0

# How often (seconds) to retry attendance records that couldn't reach the
# backend and are waiting in the local queue (offline_queue.db).
SAFETYFIRST_QUEUE_FLUSH_INTERVAL=15

# Shared secret the ESP32 sends as X-Device-Token when reporting a hazard
# straight to the Pi (used when the cloud is unreachable). Leave BLANK to
# keep that receiver switched off: it can hold the gate shut, so running it
# without a token would let anyone on the network stop the site. Set the
# same value in the sketch's secrets.h.
SAFETYFIRST_LOCAL_ALERT_TOKEN=
SAFETYFIRST_LOCAL_ALERT_PORT=8081

# Seconds between retrying locally-raised alerts against the cloud, and
# between roster/policy refreshes while it is reachable.
SAFETYFIRST_ALERT_REPLAY_INTERVAL=10
SAFETYFIRST_ROSTER_SYNC_INTERVAL=60
SAFETYFIRST_SIGNIN_RETRY_INTERVAL=20
