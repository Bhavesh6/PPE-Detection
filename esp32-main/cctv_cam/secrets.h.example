// Copy this file to secrets.h (same folder) and fill in real values.
// secrets.h is gitignored — never commit the real one.

#define WIFI_SSID "YOUR_WIFI_SSID"
#define WIFI_PASSWORD "YOUR_WIFI_PASSWORD"

// That's all this board needs. Unlike ppe_sensors and alert_sim, the
// camera never calls the backend, so there is no API_BASE and no device
// account here — nothing to sign in as, and no token to leak off a board
// that serves an open port on the LAN. The backend reaches the camera,
// not the other way round; set CCTV_STREAM_URL in the backend's .env to
// point at it (see backend/cctv.py).
//
// Put this camera on the same network as the machine running the backend.
// The backend connects *to* the camera, so a tunnel does not help: it
// exposes the backend to the world, not the world to the camera.
