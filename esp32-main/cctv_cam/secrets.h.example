// Copy this file to secrets.h (same folder) and fill in real values.
// secrets.h is gitignored — never commit the real one.

// Pick which board this is. The board_*.h files ARE tracked in git:
// they hold the camera's id and orientation, none of which is secret,
// and they are the repo's only record that a second camera exists.
//
//   board_cam.h    OV2640, gate-facing    -> safetyfirst-cam.local
//   board_yard.h   GC2145, open area      -> safetyfirst-yard.local
//
// Change this one line and reflash to turn one board into the other.
#include "board_cam.h"

#define WIFI_SSID "YOUR_WIFI_SSID"
#define WIFI_PASSWORD "YOUR_WIFI_PASSWORD"

// ---------------------------------------------------------------------
// The above is all this board needs for the normal path: the Pi reaches
// the camera and relays its frames. List it on the Pi as
//   SAFETYFIRST_CCTV_URL=cam=http://safetyfirst-cam.local,yard=http://safetyfirst-yard.local
// and put the cameras on the same network as that Pi — the Pi connects
// TO them, so a tunnel does not help; it exposes the backend outward,
// which is the opposite direction.
// ---------------------------------------------------------------------

// OPTIONAL fallback: post frames straight to the backend as well, so this
// camera stays visible while the Pi is off or rebooting. Leave both
// undefined to keep the camera credential-free, which is the safer
// default — the relay path needs nothing here.
//
// UPLOAD_TOKEN must match CCTV_UPLOAD_TOKEN in the backend's .env. It can
// do exactly one thing: replace this camera's picture. Not a login,
// deliberately — a real session on a board sitting on an open LAN would
// be worth far more if extracted.
//
// Needs internet access on the camera's WiFi. A camera down a shaft with
// no backhaul cannot use it, which is exactly why the relay exists.
//
// #define BACKEND_URL "https://your-backend.example.com"
// #define UPLOAD_TOKEN "paste_CCTV_UPLOAD_TOKEN_here"
// #define UPLOAD_INTERVAL_MS 5000   // slower than the Pi's relay on purpose
