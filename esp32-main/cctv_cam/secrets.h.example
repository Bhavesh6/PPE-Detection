// Copy this file to secrets.h (same folder) and fill in real values.
// secrets.h is gitignored — never commit the real one.

#define WIFI_SSID "YOUR_WIFI_SSID"
#define WIFI_PASSWORD "YOUR_WIFI_PASSWORD"

// This board's name. MUST be unique per camera — it becomes the mDNS
// hostname (safetyfirst-<CAM_ID>.local) AND the key the console files
// frames under. Two boards sharing an id overwrite each other's frames
// and the console shows one tile flickering between two places.
//
// Lowercase letters, digits, - and _ only, 32 chars max. Name it after
// where it points ("gate", "yard", "shaft") rather than the hardware —
// this is the label an operator reads on the tile.
#define CAM_ID "cam"

// Image orientation. These modules are often mounted inverted, but not
// all of them. Set here rather than rotating in CSS: /snapshot has no
// CSS, and every other viewer would have to know.
// #define CAM_VFLIP   1
// #define CAM_HMIRROR 1

// That's all this board needs. Unlike ppe_sensors and alert_sim, the
// camera never calls the backend, so there is no API_BASE and no device
// account here — nothing to sign in as, and no token to leak off a board
// that serves an open port on the LAN. The Pi reaches the camera, not
// the other way round; list it in SAFETYFIRST_CCTV_URL on the Pi as
// <CAM_ID>=http://safetyfirst-<CAM_ID>.local
//
// Put the camera on the same network as the Pi that relays it. The Pi
// connects TO the camera, so a tunnel does not help: it exposes the
// backend outward, which is the opposite direction.
