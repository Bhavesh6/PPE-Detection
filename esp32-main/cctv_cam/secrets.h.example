// Copy this file to secrets.h (same folder) and fill in real values.
// secrets.h is gitignored — never commit the real one.

#define WIFI_SSID "YOUR_WIFI_SSID"
#define WIFI_PASSWORD "YOUR_WIFI_PASSWORD"

// This board's name. MUST be unique per camera — it becomes the mDNS
// hostname (safetyfirst-<CAM_ID>.local) AND the key the console files
// frames under. Two boards sharing an id overwrite each other's frames
// and the console shows one tile flickering between two places.
//
// Lowercase letters, digits, - and _ only, 32 chars max. Name it after
// where it points ("gate", "yard", "shaft") rather than the hardware —
// this is the label an operator reads on the tile.
#define CAM_ID "cam"

// Image orientation. These modules are often mounted inverted, but not
// all of them. Set here rather than rotating in CSS: /snapshot has no
// CSS, and every other viewer would have to know.
// #define CAM_VFLIP   1
// #define CAM_HMIRROR 1

// ---------------------------------------------------------------------
// The above is all this board needs for the normal path: the Pi reaches
// the camera and relays its frames. List it on the Pi as
//   SAFETYFIRST_CCTV_URL=<CAM_ID>=http://safetyfirst-<CAM_ID>.local
// and put the camera on the same network as that Pi — the Pi connects TO
// the camera, so a tunnel does not help; it exposes the backend outward,
// which is the opposite direction.
// ---------------------------------------------------------------------

// OPTIONAL fallback: post frames straight to the backend as well, so
// this camera stays visible while the Pi is off or rebooting. Leave both
// undefined to keep the camera credential-free, which is the safer
// default — the relay path needs nothing here.
//
// BACKEND_URL is the public API address (the same value the Pi uses as
// SAFETYFIRST_API). UPLOAD_TOKEN must match CCTV_UPLOAD_TOKEN in the
// backend's .env. That token can do exactly one thing: replace this
// camera's picture. It is not a login, deliberately — a real session on
// a board sitting on an open LAN would be worth far more if extracted.
//
// This needs internet access on the camera's WiFi. A camera down a shaft
// with no backhaul cannot use it, which is exactly why the relay exists.
//
// #define BACKEND_URL "https://your-backend.example.com"
// #define UPLOAD_TOKEN "paste_CCTV_UPLOAD_TOKEN_here"
// #define UPLOAD_INTERVAL_MS 5000   // slower than the Pi's relay on purpose
