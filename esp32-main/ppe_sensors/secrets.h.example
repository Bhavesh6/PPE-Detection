// Copy this file to secrets.h (same folder) and fill in real values.
// secrets.h is gitignored — never commit the real one.

#define WIFI_SSID "YOUR_WIFI_SSID"
#define WIFI_PASSWORD "YOUR_WIFI_PASSWORD"

// Your PC's LAN IP, not localhost or 127.0.0.1 — the ESP32 is a separate
// device on the network. Find it with `ipconfig` (Windows) or `ip addr`
// (Linux) on the machine running `python app.py`.
#define API_BASE "http://192.168.1.42:5000"

// Required, not optional: the backend rejects guest sessions on
// /api/gate/alerts and /api/gate/sensors (device_required in gate.py) —
// guest sign-in needs no credentials at all, which used to mean anyone who
// could reach the API could hold the gate with a fabricated critical
// alert. Create a real account (web sign-up, or POST /api/auth/signup)
// dedicated to this device and put its credentials here.
#define DEVICE_EMAIL "YOUR_DEVICE_ACCOUNT_EMAIL"
#define DEVICE_PASSWORD "YOUR_DEVICE_ACCOUNT_PASSWORD"

// ---------------------------------------------------------------------
// REQUIRED once you have more than one sensor node. Names this node, and
// every reading it sends is prefixed with it: "gas" becomes "yard_gas".
//
// Without it, two nodes both reporting "gas" overwrite each other in the
// console's live readout — the backend keeps one row per kind — and you
// see whichever spoke last with no sign there are two.
//
// It also buys per-node thresholds, because thresholds are configured
// per kind. A gas limit that makes sense beside the mixer is not the one
// you want in an open yard.
//
// Short: the id plus the longest kind ("temperature") must fit in 23
// characters. Lowercase, no spaces. Leave undefined on a single-node
// site and readings stay unqualified, exactly as before.
//
// #define NODE_ID "gate"     // or "yard", "shaft", ...

// ---------------------------------------------------------------------
// OPTIONAL: report through the gate master instead of over WiFi.
//
// For a node with no network of its own — down a shaft, inside a tunnel,
// or just out of range of the site AP. It sends readings and alerts to
// the gate master over ESP-NOW, and the master forwards them to the Pi
// on its USB line. No WiFi, no sign-in, and no credentials on the board:
// WIFI_*, API_BASE and DEVICE_* above are all unused in this mode.
//
// THIS IS EITHER/OR, NOT A FALLBACK. The master never joins an AP so it
// stays on a fixed channel. A node that joins WiFi gets moved to the
// router's channel, and ESP-NOW across two channels silently does
// nothing — no error, no packet, just a sensor that looks fine and
// reports to nobody.
//
// Both values come from the line the master prints at boot:
//     # ESP-NOW ready, mac 24:6F:28:AA:BB:CC, channel 1
//
// #define REPORT_VIA_ESPNOW
// #define MASTER_MAC {0x24, 0x6F, 0x28, 0xAA, 0xBB, 0xCC}
// #define ESPNOW_CHANNEL 1
