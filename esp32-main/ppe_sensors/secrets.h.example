// Copy this file to secrets.h (same folder) and fill in real values.
// secrets.h is gitignored — never commit the real one.

#define WIFI_SSID "YOUR_WIFI_SSID"
#define WIFI_PASSWORD "YOUR_WIFI_PASSWORD"

// Your PC's LAN IP, not localhost or 127.0.0.1 — the ESP32 is a separate
// device on the network. Find it with `ipconfig` (Windows) or `ip addr`
// (Linux) on the machine running `python app.py`.
#define API_BASE "http://192.168.1.42:5000"

// Required, not optional: the backend rejects guest sessions on
// /api/gate/alerts and /api/gate/sensors (device_required in gate.py) —
// guest sign-in needs no credentials at all, which used to mean anyone who
// could reach the API could hold the gate with a fabricated critical
// alert. Create a real account (web sign-up, or POST /api/auth/signup)
// dedicated to this device and put its credentials here.
#define DEVICE_EMAIL "YOUR_DEVICE_ACCOUNT_EMAIL"
#define DEVICE_PASSWORD "YOUR_DEVICE_ACCOUNT_PASSWORD"
