// Copy this file to secrets.h (same folder) and fill in real values.
// secrets.h is gitignored — never commit the real one.

// Pick which node this is. The board_*.h files ARE tracked in git: they
// hold the node's name and reporting route, none of which is secret, and
// they are the repo's only record that a second node exists.
//
//   board_gate.h   beside the checkpoint  -> reports gate_gas, gate_temperature, ...
//   board_yard.h   the second position    -> reports yard_gas, yard_temperature, ...
//
// Change this one line and reflash to turn one board into the other.
#include "board_gate.h"

#define WIFI_SSID "YOUR_WIFI_SSID"
#define WIFI_PASSWORD "YOUR_WIFI_PASSWORD"

// Where the SafetyFirst API lives. Your PC's LAN IP or a public URL — not
// localhost or 127.0.0.1, which on this board mean the board itself.
// Unused when the chosen board file selects ESP-NOW reporting.
#define API_BASE "http://192.168.1.42:5000"

// Device account. Required, not optional: the backend rejects guest
// sessions on /api/gate/alerts and /api/gate/sensors (device_required in
// gate.py), because guest sign-in needs no credentials at all — which
// used to mean anyone who could reach the API could hold the gate shut
// with a fabricated critical alert. Create a real account for this device
// (web sign-up, or POST /api/auth/signup) and put it here.
//
// Also unused under ESP-NOW reporting: that route carries no credentials
// at all, because the master and the Pi vouch for it instead.
#define DEVICE_EMAIL "YOUR_DEVICE_ACCOUNT_EMAIL"
#define DEVICE_PASSWORD "YOUR_DEVICE_ACCOUNT_PASSWORD"
